  "questions": [
    {
      "id": "m2010_q1",
      "text": "Laquelle des égalités suivantes est vraie ?",
      "choices": {
        "a": "$tg(\\alpha+\\beta)=\\dfrac{tg\\alpha-tg\\beta}{1+tg\\alpha}$",
        "b": "$tg(\\alpha+\\beta)=\\dfrac{tg\\alpha\\,tg\\beta}{tg\\alpha+tg\\beta}$",
        "c": "$tg(\\alpha+\\beta)=\\dfrac{tg\\alpha+tg\\beta}{1-tg\\alpha\\,tg\\beta}$",
        "d": "$tg(\\alpha+\\beta)=\\dfrac{tg\\alpha-tg\\beta}{tg\\alpha\\,tg\\beta}$"
      },
      "correct": "c",
      "explication": "C'est la formule d'addition standard de la tangente."
    },
    {
