{
  "questions": [
    {
      "id": "m2017_q1",
      "text": "Quelle est la valeur de $b$ pour que la fonction $f(x)=\\begin{cases}1+e^{-2x}&\\text{si }0\\leq x\\leq b\\\\1+e^{2x-12}&\\text{si }b<x\\leq6\\end{cases}$ soit continue sur $[0,6]$ ?",
      "choices": {
        "a": "$1$",
        "b": "$2$",
        "c": "$3$",
        "d": "$4$"
      },
      "correct": "c",
      "explication": "Continuité en $x=b$ : $1+e^{-2b}=1+e^{2b-12}\\Rightarrow-2b=2b-12\\Rightarrow b=3$."
    },
    {
      "id": "m2017_q2",
      "text": "Laquelle des fonctions suivantes représente le graphe de $f$ décalé d'une unité vers la gauche ?",
      "choices": {
        "a": "$f(x-1)$",
        "b": "$f(x)-1$",
        "c": "$f(x+1)$",
        "d": "$f(x)+1$"
      },
      "correct": "c",
      "explication": "Un décalage vers la gauche de $a$ unités transforme $f(x)$ en $f(x+a)$."
    },
    {
      "id": "m2017_q3",
      "text": "Soit $A=\\{a\\in\\mathbb{R}:-3<a\\leq1\\}$ et $B=\\{b\\in\\mathbb{R}:-3<b<1\\}$. Laquelle des affirmations suivantes est fausse ?",
      "choices": {
        "a": "$\\forall a\\in A\\ \\exists b\\in B\\ (b<a)$",
        "b": "$\\exists b\\in B\\ \\forall a\\in A\\ (b<a)$",
        "c": "$\\exists b\\in B\\ \\exists a\\in A\\ (b<a)$",
        "d": "$\\exists a\\in A\\ \\forall b\\in B\\ (b<a)$"
      },
      "correct": "b",
      "explication": "$B$ n'a pas de minimum ($\\inf B=-3$ non atteint) : aucun $b\\in B$ ne peut être inférieur à TOUS les éléments de $A$."
    },
    {
      "id": "m2017_q4",
      "text": "Si $f'(x)$ et $g'(x)$ existent avec $f'(x)>g'(x)$ pour tout réel $x$ alors les graphes de $f$ et $g$",
      "choices": {
        "a": "se coupent une seule fois",
        "b": "ne se coupent pas",
        "c": "se coupent au plus une fois",
        "d": "se coupent plus d'une fois"
      },
      "correct": "c",
      "explication": "$h=f-g$ est strictement croissante ($h'>0$), donc s'annule au plus une fois."
    },
    {
      "id": "m2017_q5",
      "text": "Si $\\log_a(2^a)=\\dfrac{a}{4}$ alors",
      "choices": {
        "a": "$a=2$",
        "b": "$a=4$",
        "c": "$a=8$",
        "d": "$a=16$"
      },
      "correct": "d",
      "explication": "$a\\log_a2=\\dfrac{a}{4}\\Rightarrow\\log_a2=\\dfrac14\\Rightarrow2=a^{1/4}\\Rightarrow a=16$."
    },
    {
      "id": "m2017_q6",
      "text": "L'intégrale $\\displaystyle\\int_0^{\\pi/4}\\tan^2(x)dx$ est égale à",
      "choices": {
        "a": "$\\dfrac{\\pi}{4}-1$",
        "b": "$1-\\dfrac{\\pi}{4}$",
        "c": "$\\dfrac13$",
        "d": "$\\sqrt2-1$"
      },
      "correct": "b",
      "explication": "$\\tan^2x=\\sec^2x-1$, donc $\\int\\tan^2x\\,dx=\\tan x-x$ ; évalué entre $0$ et $\\pi/4$ : $1-\\pi/4$."
    },
    {
      "id": "m2017_q7",
      "text": "On pose $f(x)=\\displaystyle\\int_0^x\\dfrac{1}{\\sqrt{t^3+2}}dt$. Laquelle des affirmations suivantes est fausse ?",
      "choices": {
        "a": "$f(1)>0$",
        "b": "$f(-1)>0$",
        "c": "$f'(1)=\\dfrac{1}{\\sqrt3}$",
        "d": "$f(0)=0$"
      },
      "correct": "b",
      "explication": "Pour $t\\in[-1,0]$, l'intégrande est positive, donc $f(-1)=-\\int_{-1}^0(\\text{positif})\\,dt<0$."
    },
    {
      "id": "m2017_q8",
      "text": "Quelle est la valeur moyenne de $1-t^2$ dans l'intervalle $[-1,1]$ ?",
      "choices": {
        "a": "$1$",
        "b": "$\\dfrac23$",
        "c": "$\\dfrac43$",
        "d": "$0$"
      },
      "correct": "b",
      "explication": "Valeur moyenne $=\\dfrac12\\int_{-1}^1(1-t^2)dt=\\dfrac12\\times\\dfrac43=\\dfrac23$."
    },
    {
      "id": "m2017_q9",
      "text": "Soit $f:\\mathbb{R}\\to\\mathbb{R}$ une fonction impaire. Si $f$ est dérivable en $x_0$ alors",
      "choices": {
        "a": "$f'(-x_0)=f'(x_0)$",
        "b": "$f'(-x_0)=-f'(x_0)$",
        "c": "$f'(-x_0)=\\dfrac{1}{f'(x_0)}$",
        "d": "$f'(-x_0)=-\\dfrac{1}{f'(x_0)}$"
      },
      "correct": "a",
      "explication": "En dérivant $f(-x)=-f(x)$ : $-f'(-x)=-f'(x)$, donc $f'(-x)=f'(x)$ : la dérivée d'une fonction impaire est paire."
    },
    {
      "id": "m2017_q10",
      "text": "On pose $l=\\displaystyle\\lim_{x\\to+\\infty}(e^x-1)^{1/x}$.",
