        "b": "$l=+\\infty$",
        "c": "$l=e$",
        "d": "$l=-\\infty$"
      },
      "correct": "c",
      "explication": "$e^x-1\\approx e^x$ pour $x$ grand, donc $(e^x)^{1/x}=e$."
    },
    {
